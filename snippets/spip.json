{
  "Boucle simple": {
    "prefix": "boucle",
    "body": [
      "<BOUCLE_${1:name}(${2:ARTICLES}){${3:criteria}}{${4:par num titre, titre}}>",
      "\t$0",
      "</BOUCLE_$1>"
    ],
    "description": "Boucle SPIP simple"
  },
  "Boucle complète": {
    "prefix": "bouclec",
    "body": [
      "<B_${1:name}>",
      "<BOUCLE_$1(${2:ARTICLES}){${3:criteria}}{${4:par num titre, titre}}>",
      "\t#TITRE",
      "\t#TEXTE",
      "</BOUCLE_$1>",
      "</B_$1>",
      "<//B_$1>"
    ],
    "description": "Boucle SPIP complète avec conditionnelles"
  },
  "Logo SPIP": {
    "prefix": "logo",
    "body": [
      "[(#LOGO_${1:ARTICLE}|image_passe_partout{$2,$3}|image_recadre{$2,$3}|extraire_attribut{src})]"
    ],
    "description": "Logo SPIP avec traitements d'image"
  },
  "Image SPIP": {
    "prefix": "img",
    "body": [
      "[<img src=\"(#LOGO_${1:ARTICLE}|image_passe_partout{$2,$3}|image_recadre{$2,$3}|extraire_attribut{src})\" alt=\"[(#TITRE|attribut_html)]\">]"
    ],
    "description": "Balise img avec logo SPIP"
  },
  "Commentaire SPIP": {
    "prefix": "rem",
    "body": ["[(#REM) ${1:commentaire} ]$0"],
    "description": "Commentaire SPIP"
  },
  "Inclure": {
    "prefix": "inclure",
    "body": ["<INCLURE{fond=${1:inclure/footer}${2:,id_rubrique}${3:,env}} />$0"],
    "description": "Inclusion dynamique"
  },
  "Array init": {
    "prefix": "array-init",
    "body": ["#SET{${1:nom_tableau}, #ARRAY}$0"],
    "description": "Initialisation tableau"
  },
  "Array push": {
    "prefix": "array-push",
    "body": ["#SET{${1:nom_tableau}, #GET{$1}|push{${2:valeur}}}$0"],
    "description": "Ajout d'une valeur à un tableau"
  },
  "Array in_array": {
    "prefix": "array-inarray",
    "body": ["[(${1:#VAL{toto}}|in_any{#GET{${2:nom_tableau}}}|oui) $3]$0"],
    "description": "Affichage conditionnel si valeur présente dans tableau"
  },
  "Array dump": {
    "prefix": "array-dump",
    "body": ["[(#GET{${1:nom_tableau}}|foreach)]$0"],
    "description": "Affiche un tableau"
  },

